NODE_ENV=development
PORT=4000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codeforces_classroom?schema=public"

# Codeforces API Credentials (Optional for public endpoints, required for private/authenticated)
CODEFORCES_API_KEY=""
CODEFORCES_API_SECRET=""

# Teacher Codeforces Handle
TEACHER_CF_HANDLE="tourist"

# Telegram Bot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_IDS="123456789"

# Redis (Optional)
REDIS_URL="redis://localhost:6379"

# App URLs
WEB_URL="http://localhost:3000"
API_URL="http://localhost:4000"

# JWT Secret (generate a random value of at least 32 characters; share it with the web app)
JWT_SECRET=""
