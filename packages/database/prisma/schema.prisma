generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  passwordHash     String
  role             String   @default("teacher") // "teacher" | "admin"
  codeforcesHandle String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("users")
}

model Classroom {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  students    Student[]

  @@map("classes")
}

model Student {
  id                   String                 @id @default(uuid())
  name                 String
  codeforcesHandle     String                 @unique
  classId              String
  group                String?
  active               Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  classroom            Classroom              @relation(fields: [classId], references: [id], onDelete: Cascade)
  stats                StudentStats?
  submissions          Submission[]
  contestParticipations ContestParticipation[]

  @@index([codeforcesHandle])
  @@index([classId])
  @@map("students")
}

model StudentStats {
  id           String   @id @default(uuid())
  studentId    String   @unique
  rating       Int      @default(0)
  rank         String   @default("unrated")
  maxRating    Int      @default(0)
  maxRank      String   @default("unrated")
  solvedCount  Int      @default(0)
  contestCount Int      @default(0)
  avatar       String?
  lastSyncedAt DateTime @default(now())
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_stats")
}

model Submission {
  id             String   @id @default(uuid())
  studentId      String
  cfSubmissionId Int      @unique
  contestId      Int?
  problemIndex   String
  problemName    String
  problemRating  Int?
  tags           String   @default("[]") // JSON string of tags array
  verdict        String
  language       String
  submittedAt    DateTime
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([cfSubmissionId])
  @@index([submittedAt])
  @@map("submissions")
}

model Contest {
  id                  String                 @id @default(uuid())
  codeforcesContestId Int                    @unique
  name                String
  phase               String                 // "BEFORE" | "CODING" | "PENDING_SYSTEM_TEST" | "SYSTEM_TEST" | "FINISHED"
  startTime           DateTime
  durationSeconds     Int
  lastSyncedAt        DateTime               @default(now())
  participations      ContestParticipation[]

  @@index([codeforcesContestId])
  @@index([startTime])
  @@map("contests")
}

model ContestParticipation {
  id             String   @id @default(uuid())
  contestId      String
  studentId      String
  rank           Int
  ratingBefore   Int
  ratingAfter    Int
  ratingChange   Int
  problemsSolved Int
  contest        Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([contestId, studentId])
  @@index([contestId])
  @@index([studentId])
  @@map("contest_participation")
}
